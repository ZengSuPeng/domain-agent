# ============ 后端环境变量（Render 配置）============
# 本地可复制为 .env：支持 KEY=VALUE，也兼容 KEY: VALUE
# 以及飞书文档常见的 app_id / APP_SECRET 写法。

# ---------- 飞书登录授权（不配则不启用登录校验，本地开发方便）----------
# 获取：https://open.feishu.cn/app → 你的应用 → 凭证与基础信息
# 注意：只要配了 App ID / App Secret 其中任意一个，就视为启用登录；
#       缺另一个时所有 /api 请求返回 503（失败关闭，避免误以为有保护）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 回调地址，必须与开发者后台「开发配置 → 安全设置 → 重定向 URL」完全一致。
# 不填则自动用请求域名拼 /api/auth/feishu/callback：
#   本地   http://127.0.0.1:8001/api/auth/feishu/callback
#   生产   https://domain-agent-33im.onrender.com/api/auth/feishu/callback
FEISHU_REDIRECT_URI=

# 前端地址（前端独立部署时填，如 Cloudflare Pages 域名）。
# 不填默认用后端同源地址；登录成功后的回跳仍以页面自身 origin 为准。
FRONTEND_URL=

# session 签名密钥（推荐单独配一个随机长字符串）。
# 不填时自动用 FEISHU_APP_SECRET 派生：Render 重启不会掉线，但换 App Secret 会全部失效。
AUTH_SECRET=
AUTH_SESSION_HOURS=12

# 访问白名单（可选，逗号分隔）。两个都留空 = 应用可见范围内的所有飞书成员。
# 邮箱支持精确匹配和通配域名：a@corp.com,*@corp.com
# 用邮箱白名单需要在开发者后台开通 contact:user.email:readonly，
# 并把下面 FEISHU_SCOPE 设为 contact:user.email:readonly（否则 user_info 不返回邮箱）。
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_OPEN_IDS=

# 租户白名单（可选）：填飞书 tenant_key，只允许本企业租户登录（默认不校验）。
# tenant_key 在 user_info 里默认返回，不需要额外权限。
AUTH_ALLOWED_TENANT_KEYS=

# 授权时申请的用户权限（空格分隔）。只按 open_id 白名单可留空。
FEISHU_SCOPE=

# 国际版 Lark 才需要改这两个域名
FEISHU_ACCOUNTS_BASE=https://accounts.feishu.cn
FEISHU_API_BASE=https://open.feishu.cn

# 生产环境建议设为 1：即使凭证漏配也拒绝所有 /api 请求（失败关闭），避免裸奔。
# 本地 .env 不要设这个，保持「没配凭证直接进」的开发体验。
AUTH_REQUIRED=

# 强制关闭登录校验（仅本地/内网调试，生产不要开）
AUTH_DISABLED=

# DeepSeek 官方 API Key（域名生成用，platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# GPT API Key（合规检测用，可选：不填则跳过合规检测）
GPT_API_KEY=sk-xxxxxxxxxxxxxxxx

# Cloudflare 配置（域名可注册性检测用）
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# VirusTotal API Key（历史痕迹检测用，www.virustotal.com 免费申请，额度 4 次/分钟）
# 不填则跳过 VirusTotal 源（不影响其他三个源）
VIRUSTOTAL_API_KEY=

# DMXAPI 平台管理接口（查余额用）
# 注意：这两个不是调模型的 sk-... key，而是「系统访问令牌 + 用户ID」
# 获取：https://www.dmxapi.cn/profile（安全与访问 → 访问令牌；个人资料 → 用户 ID）
# 不填则页面显示「DMXAPI 未配置」，不影响合规检测
DMXAPI_SYSTEM_TOKEN=
DMXAPI_USER_ID=

# 允许的前端 Origin（逗号分隔，例如 Cloudflare Pages 域名）。
# 飞书登录回调也复用这份列表做「回跳地址」白名单，务必包含真实前端域名。
CORS_ORIGINS=https://你的前端.pages.dev,http://localhost:5173

# archive.org 代理（仅本地开发需要，Render 等海外服务器留空即可）
# archive.org 在中国大陆访问不稳定，本地开发时指向你的代理端口
# 例如：ARCHIVE_PROXY=http://127.0.0.1:7890
ARCHIVE_PROXY=

# PostgreSQL 数据库连接串（不可用域名库持久化用）
# Render 部署：在 Render 上创建 PostgreSQL 后，将 Internal Database URL 填到这里
# 本地开发：不填则自动回退到本地 JSON 文件存储
# 格式：postgresql://user:password@host:port/dbname
DATABASE_URL=
