# ============ 后端环境变量（Render 配置）============

# dmxapi.cn 的 API Key（域名生成用）
DMXAPI_KEY=sk-xxxxxxxxxxxxxxxx

# GPT API Key（合规检测用，可选：不填则跳过合规检测）
GPT_API_KEY=sk-xxxxxxxxxxxxxxxx

# Cloudflare 配置（域名可注册性检测用）
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# 允许的前端域名（逗号分隔，Vercel 部署后填你的 Vercel 域名）
CORS_ORIGINS=https://你的前端.vercel.app,http://localhost:5173
