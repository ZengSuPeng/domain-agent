# ============ 后端环境变量（Render 配置）============

# DeepSeek 官方 API Key（域名生成用，platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# GPT API Key（合规检测用，可选：不填则跳过合规检测）
GPT_API_KEY=sk-xxxxxxxxxxxxxxxx

# Cloudflare 配置（域名可注册性检测用）
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# VirusTotal API Key（历史痕迹检测用，www.virustotal.com 免费申请，额度 4 次/分钟）
# 不填则跳过 VirusTotal 源（不影响其他三个源）
VIRUSTOTAL_API_KEY=

# 允许的前端域名（逗号分隔，Vercel 部署后填你的 Vercel 域名）
CORS_ORIGINS=https://你的前端.vercel.app,http://localhost:5173

# archive.org 代理（仅本地开发需要，Render 等海外服务器留空即可）
# archive.org 在中国大陆访问不稳定，本地开发时指向你的代理端口
# 例如：ARCHIVE_PROXY=http://127.0.0.1:7890
ARCHIVE_PROXY=

# PostgreSQL 数据库连接串（不可用域名库持久化用）
# Render 部署：在 Render 上创建 PostgreSQL 后，将 Internal Database URL 填到这里
# 本地开发：不填则自动回退到本地 JSON 文件存储
# 格式：postgresql://user:password@host:port/dbname
DATABASE_URL=
